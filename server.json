{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.batrarishab14/fixwitness",
  "title": "fixwitness",
  "description": "Checks that an AI fix to a script, SQL query or dbt model fixed the problem and changed nothing else.",
  "version": "0.6.0",
  "repository": {
    "url": "https://github.com/batrarishab14/fixwitness",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "fixwitness",
      "version": "0.6.0",
      "runtimeHint": "uvx",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }]
    }
  ]
}
