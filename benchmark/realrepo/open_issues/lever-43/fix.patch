diff --git a/models/intermediate/int_lever__interview_feedback.sql b/models/intermediate/int_lever__interview_feedback.sql
index 16e3978..b687410 100644
--- a/models/intermediate/int_lever__interview_feedback.sql
+++ b/models/intermediate/int_lever__interview_feedback.sql
@@ -20,10 +20,12 @@ feedback_form as (
     where deleted_at is null
 ),
 
-join_w_feedback as (
+-- feedback links to forms that are not deleted: a link to a deleted form adds no row
+live_interview_feedback as (
 
     select
-        interview.*,
+        interview_feedback.interview_id,
+        interview_feedback.source_relation,
         feedback_form.feedback_form_id,
         feedback_form.creator_user_id as feedback_completer_user_id,
         feedback_form.completed_at as feedback_completed_at,
@@ -32,14 +34,29 @@ join_w_feedback as (
         feedback_form.score_system_value,
         feedback_form.form_title as feedback_form_title
 
-
-    from interview
-    left join interview_feedback 
-        on interview.interview_id = interview_feedback.interview_id
-        and interview.source_relation = interview_feedback.source_relation
-    left join feedback_form 
+    from interview_feedback
+    inner join feedback_form 
         on interview_feedback.feedback_form_id = feedback_form.feedback_form_id
         and interview_feedback.source_relation = feedback_form.source_relation
+),
+
+join_w_feedback as (
+
+    select
+        interview.*,
+        live_interview_feedback.feedback_form_id,
+        live_interview_feedback.feedback_completer_user_id,
+        live_interview_feedback.feedback_completed_at,
+
+        live_interview_feedback.feedback_form_instructions,
+        live_interview_feedback.score_system_value,
+        live_interview_feedback.feedback_form_title
+
+
+    from interview
+    left join live_interview_feedback 
+        on interview.interview_id = live_interview_feedback.interview_id
+        and interview.source_relation = live_interview_feedback.source_relation
 )
 
 select *
